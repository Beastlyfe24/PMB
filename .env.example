# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polymarket_mirror?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Safety Controls
DRY_RUN=true
KILL_SWITCH=false

# Polymarket Configuration
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_FUNDER_ADDRESS=0x...
POLYMARKET_CHAIN_ID=137

# Polymarket API Endpoints
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
POLYMARKET_RTDS_WSS=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Server
API_PORT=3001
WEB_PORT=3000
